{
  "name": "thnk",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "bin": {
    "thnk": "./bin/thnk.js"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.18.x",
    "yarn": "1.22.x"
  },
  "workspaces": [
    "code/*"
  ],
  "scripts": {
    "postinstall": "node ./scripts/generate-protocol.js",
    "test": "jest",
    "ts": "tsc",
    "format": "prettier --write ./bin/*.js ./code/**/* ./scripts/**/*.js ./scripts/**/*.cjs",
    "generate-protocol": "node ./scripts/generate-protocol.js",
    "fixture:m1:prepare": "node ./scripts/m1/prepare-fixture.js",
    "fixture:m1:export-client": "node ./scripts/m1/export-client.js",
    "fixture:m1:serve-client": "node ./scripts/m1/serve-client.js",
    "fixture:m1:runtime-check": "node ./scripts/m1/runtime-check.js",
    "fixture:m1:validate": "node ./scripts/m1/validate-fixture.js",
    "fixture:m2:export": "node ./scripts/m2/export-fixture.js",
    "fixture:m2:multi-client": "node ./scripts/m2/multi-client-check.js",
    "fixture:m2:validate": "node ./bin/thnk.js server validate --bundle ./.generated/m2/server-bundle",
    "fixture:m3:check": "node ./scripts/m3/integration-check.js",
    "fixture:m4:check": "node ./scripts/m4/integration-check.js",
    "fixture:m4:live": "node ./scripts/m4/live-agora-check.js",
    "fixture:m5:prepare": "node ./scripts/m5/prepare-fixture.js",
    "fixture:m5:export-client": "node ./scripts/m5/export-client.js",
    "fixture:m5:export": "node ./scripts/m5/export-fixture.js",
    "fixture:m5:validate": "node ./bin/thnk.js server validate --bundle ./.generated/m5/server-bundle",
    "fixture:m5:check": "node ./scripts/m5/integration-check.js",
    "fixture:m6:prepare": "node ./scripts/m6/prepare-fixture.js",
    "fixture:m6:export-client": "node ./scripts/m6/export-client.js",
    "fixture:m6:export": "node ./scripts/m6/export-fixture.js",
    "fixture:m6:validate": "node ./bin/thnk.js server validate --bundle ./.generated/m6/server-bundle",
    "fixture:m6:check": "node ./scripts/m6/integration-check.js",
    "fixture:m7:prepare": "node ./scripts/m7/prepare-fixture.js",
    "fixture:m7:export-client": "node ./scripts/m7/export-client.js",
    "fixture:m7:export": "node ./scripts/m7/export-fixture.js",
    "fixture:m7:validate": "node ./bin/thnk.js server validate --bundle ./.generated/m7/server-bundle",
    "fixture:m7:check": "node ./scripts/m7/integration-check.js",
    "ci:secret-scan": "node ./scripts/m7/secret-scan.js",
    "ci:production-audit": "node ./scripts/m7/production-audit.js",
    "ci:headless-smoke": "node ./scripts/m7/headless-smoke.js",
    "ci:stub-smoke": "node ./scripts/m7/stub-smoke.js",
    "certification:forwarders": "node ./scripts/certification/tcp-forwarders.mjs",
    "certification:production-handoff": "node ./scripts/certification/production-handoff-load.mjs",
    "certification:profile-policy": "node ./scripts/certification/profile-policy-integration.mjs",
    "certification:production-policy": "node ./scripts/certification/production-policy-recovery.mjs",
    "thnk": "node ./bin/thnk.js",
    "build:thnk": "tsup ./code/index.ts --format esm --platform=browser --treeshake smallest --minify && tsup ./dist/index.mjs --format iife --platform=browser --global-name THNK --minify && node -e \"fs.promises.rm('./dist/index.mjs', {force:true})\"",
    "build:thnk:dev": "tsup ./code/index.ts --format iife --platform=browser --global-name THNK",
    "build:protocol-debug": "tsup ./code/t-h-n-k/index.ts --format iife --platform=browser --global-name T",
    "build:adapters": "tsup ./code/adapters/Adapter.ts ./code/adapters/geckos-server.ts ./code/adapters/local.ts ./code/adapters/p2p.ts ./code/adapters/relay.ts --format iife && tsup ./code/adapters/geckos-client.ts --format iife --minify && tsup ./code/adapters/geckos-server.ts --minify --format cjs",
    "build:extensions": "node ./scripts/generate-extensions.js",
    "build:clean": "node -e \"fs.promises.rm('./dist', {recursive:true,force:true})\"",
    "build": "yarn build:clean && yarn generate-protocol && yarn build:thnk && yarn build:adapters && yarn build:extensions"
  },
  "devDependencies": {
    "@types/follow-redirects": "^1.14.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.0",
    "flatbuffers": "^2.0.6",
    "jest": "30.4.2",
    "prettier": "^2.7.1",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "ws": "8.21.1"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "@geckos.io/client": "3.1.0",
    "@geckos.io/server": "3.1.0",
    "agora-rtc-sdk-ng": "4.24.6",
    "agora-token": "2.0.5",
    "electron": "43.1.1",
    "follow-redirects": "^1.16.0",
    "msgpackr": "^2.0.4",
    "node-stream-zip": "^1.15.0",
    "pako": "^3.0.1"
  },
  "resolutions": {
    "**/@istanbuljs/load-nyc-config/js-yaml": "3.15.0",
    "**/anymatch/picomatch": "2.3.2",
    "**/execa/cross-spawn": "7.0.6",
    "**/make-dir/semver": "6.3.1",
    "**/node-abi/semver": "7.8.5",
    "**/prebuild-install/tar-fs": "2.1.5",
    "**/test-exclude/minimatch": "3.1.4",
    "**/test-exclude/**/brace-expansion": "1.1.13",
    "**/test-exclude/**/minimatch": "3.1.4"
  }
}
