[Unit]
Description=THNK Feature Lab development Authority
After=network-online.target thnk-matchmaking.service thnk-playerprofile.service
Wants=network-online.target

[Service]
Type=simple
User=smile
WorkingDirectory=/home/smile/thnk-dev/authority
Environment=NODE_ENV=production
EnvironmentFile=/home/smile/thnk-dev/config/authority.env
ExecStart=/usr/local/bin/thnk-run-authority
Restart=always
RestartSec=3
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
